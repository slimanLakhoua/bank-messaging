# Local development only. Replace the three passwords before starting.
POSTGRES_DB=bank
POSTGRES_USER=bank
POSTGRES_PASSWORD=local-db-change-me
POSTGRES_PORT=55432
MQ_APP_PASSWORD=local-mq-change-me
MQ_ADMIN_PASSWORD=local-admin-change-me
MQ_PORT=1414
MQ_WEB_PORT=9443
# IBM MQ Advanced for Developers license: see infra/README.md.
MQ_LICENSE=accept
SERVER_PORT=8080

# Ingestion P2
INGESTION_ENABLED=true
MQ_INPUT_QUEUE=DEV.BANK.IN
MQ_BACKOUT_QUEUE=DEV.BANK.BACKOUT
INGESTION_CONCURRENCY=1
# Optional maximum; when absent defaults to INGESTION_CONCURRENCY. Must be < SQL_POOL_SIZE.
# INGESTION_MAX_CONCURRENCY=4
SQL_POOL_SIZE=5
SQL_CONNECTION_TIMEOUT_MS=5000
INGESTION_RETRY_DELAY_MS=1000
INGESTION_MAX_ATTEMPTS=3
INGESTION_MAX_PAYLOAD_BYTES=1048576

# Optional production-build frontend in compose.app.yaml
WEB_PORT=8088
