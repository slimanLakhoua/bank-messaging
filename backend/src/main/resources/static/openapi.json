{
  "openapi": "3.1.0",
  "info": {
    "title": "Consultation BANK",
    "version": "1.1.0",
    "description": "Consultation seule. Les listes excluent le payload. Cache-Control: no-store. Identité de transport scoped par file."
  },
  "servers": [
    {
      "url": "/",
      "description": "Serveur courant (accès direct ou via Nginx)"
    }
  ],
  "paths": {
    "/api/messages": {
      "get": {
        "operationId": "listMessages",
        "summary": "Consulter les métadonnées paginées et filtrées",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page à partir de zéro",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "Taille de page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "messageId",
            "in": "query",
            "required": false,
            "description": "Correspondance exacte, sans recherche dans le payload",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          {
            "name": "sourceQueue",
            "in": "query",
            "required": false,
            "description": "Correspondance exacte, sans recherche dans le payload",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Début inclus, instant ISO-8601 avec fuseau",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Fin exclue ; strictement après from",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Tri par date puis ID dans la même direction",
            "schema": {
              "type": "string",
              "enum": [
                "receivedAt,desc",
                "receivedAt,asc"
              ],
              "default": "receivedAt,desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page, y compris vide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessagePage"
                }
              }
            }
          },
          "400": {
            "description": "Erreur de requête ou dépendance indisponible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Erreur de requête ou dépendance indisponible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/messages/{id}": {
      "get": {
        "operationId": "getMessage",
        "summary": "Consulter un message avec son payload brut",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Message trouvé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageDetails"
                }
              }
            }
          },
          "400": {
            "description": "Erreur de requête ou dépendance indisponible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Erreur de requête ou dépendance indisponible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Erreur de requête ou dépendance indisponible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MessageSummary": {
        "type": "object",
        "required": [
          "id",
          "sourceQueue",
          "jmsMessageId",
          "correlationId",
          "receivedAt",
          "contentType",
          "payloadSize"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "sourceQueue": {
            "type": "string"
          },
          "jmsMessageId": {
            "type": "string"
          },
          "correlationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "contentType": {
            "type": "string"
          },
          "payloadSize": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "MessageDetails": {
        "allOf": [
          {
            "$ref": "#/components/schemas/MessageSummary"
          },
          {
            "type": "object",
            "required": [
              "payload"
            ],
            "properties": {
              "payload": {
                "type": "string"
              }
            }
          }
        ]
      },
      "MessagePage": {
        "type": "object",
        "required": [
          "content",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ],
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageSummary"
            },
            "maxItems": 100
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalElements": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        }
      }
    }
  }
}
